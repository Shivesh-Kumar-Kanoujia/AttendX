# AttendX Backend — .env.example
# Copy this file to .env and fill in your Firebase service account details.

# Option A: Path to the service account JSON (recommended)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: Manual credential fields (paste values from the JSON file)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Backend host/port
HOST=127.0.0.1
PORT=8000

# Production settings (used by Railway)
# ENVIRONMENT=production
# FRONTEND_URL=https://attendx.vercel.app